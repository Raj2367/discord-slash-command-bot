# Required environment variables — must be set for the application to run
DATABASE_URL=        # Pooled runtime connection string (Neon/PostgreSQL)
DIRECT_URL=          # Direct connection string for Prisma migrations

DISCORD_APPLICATION_ID=    # Discord application (bot) client ID
DISCORD_PUBLIC_KEY=        # Discord application public key (for signature verification)
DISCORD_BOT_TOKEN=         # Discord bot token (do NOT commit real values)
DISCORD_GUILD_ID=          # Discord guild (server) ID for guild-scoped commands

SESSION_SECRET=              # Strong random string; required for production session cookies (change this default)
SEED_ADMIN_EMAIL=            # Initial admin email for database seeding
SEED_ADMIN_PASSWORD=         # Initial admin password for seeding; change before any non-test use

# Optional environment variables
SIGNATURE_MAX_AGE_SECONDS=300   # Discord signature timestamp freshness window in seconds (default: 300)
GEMINI_API_KEY=                 # Optional Google Gemini API key for AI summarization feature
